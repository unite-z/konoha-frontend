# Servidor estático de la PWA dentro del contenedor web. El HTTPS lo pone el Caddy de borde.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# El service worker y el manifiesto nunca se cachean: así una versión nueva llega en la siguiente visita.
	@sinCache path /sw.js /registerSW.js /manifest.webmanifest /index.html
	header @sinCache Cache-Control "no-cache"

	# Los ficheros con hash en el nombre no cambian nunca.
	@conHash path /assets/*
	header @conHash Cache-Control "public, max-age=31536000, immutable"

	# Rutas de React: cualquier ruta desconocida devuelve index.html.
	try_files {path} /index.html
	file_server
}
